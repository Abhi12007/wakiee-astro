---
import BaseLayout from "../layouts/BaseLayout.astro";
import RoomShell from "../components/RoomShell.jsx";

const title =
  "Random Chat Rooms | Talk to People Online | Wakiee";

const description =
  "Join Wakiee random chat rooms and talk with people online. Meet new people, join conversations, and connect with strangers from around the world.";

const keywords =
  "random chat rooms, chat rooms, online chat rooms, talk to strangers, random chat, chat with strangers, stranger chat, free chat rooms, Wakiee rooms";

const canonical = "https://wakiee.live/rooms";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://wakiee.live/rooms#webapp",
      "name": "Wakiee Chat Rooms",
      "url": "https://wakiee.live/rooms",
      "applicationCategory": "CommunicationApplication",
      "operatingSystem": "All",
      "description":
        "Wakiee provides online chat rooms where people can meet and talk with strangers from around the world.",
      "isPartOf": {
        "@id": "https://wakiee.live/#website"
      },
      "publisher": {
        "@id": "https://wakiee.live/#organization"
      }
    },

    {
      "@type": "WebPage",
      "@id": "https://wakiee.live/rooms#webpage",
      "url": "https://wakiee.live/rooms",
      "name": title,
      "description": description,
      "isPartOf": {
        "@id": "https://wakiee.live/#website"
      },
      "about": {
        "@id": "https://wakiee.live/rooms#webapp"
      }
    },

    {
      "@type": "BreadcrumbList",
      "@id": "https://wakiee.live/rooms#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://wakiee.live/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Chat Rooms",
          "item": "https://wakiee.live/rooms"
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  robots="index, follow, max-image-preview:large"
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogUrl={canonical}
  ogType="website"
  twitterTitle={title}
  twitterDescription={description}
  twitterImage="https://wakiee.live/banner.webp"
  schema={schema}
>
  <RoomShell client:load />
</BaseLayout>
