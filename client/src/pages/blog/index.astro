---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  robots="index, follow, max-image-preview:large"
  canonical={canonical}
  ogTitle="Wakiee Blog"
  ogDescription="Learn how to talk to strangers and improve communication skills."
  ogUrl={canonical}
  ogType="website"
  twitterTitle="Wakiee Blog"
  twitterDescription="Learn how to talk to strangers and improve communication skills."
  twitterImage="https://wakiee.live/banner.webp"
  schema={schema}
>
  <div class="blog-container">

    <h1 class="blog-title">Wakiee Blog</h1>

    <p class="blog-subtitle">
      Explore stories, tips, and experiences about learning cultures,
      friendships, and online communication through <strong>Wakiee</strong>.
    </p>

    <!-- ---------- Blog Categories ---------- -->
    <div class="blog-category-box">

      <h2 class="blog-category-title">
        Category
      </h2>

      <div class="blog-category-list">

        {
          categories.map((category) => (
            <button
              type="button"
              class:list={[
                "blog-category-button",
                { active: category === "All" }
              ]}
              data-category={category}
              aria-pressed={category === "All" ? "true" : "false"}
            >
              {category}
            </button>
          ))
        }

      </div>

    </div>

    <!-- ---------- Blog Grid ---------- -->
    <div class="blog-grid" id="blog-grid">

      {
        posts.map((post) => (
          <PostCard
            post={post}
            data-category={post.category}
          />
        ))
      }

    </div>

  </div>
</BaseLayout>

<script>
  const categoryButtons =
    document.querySelectorAll(".blog-category-button");

  const blogCards =
    document.querySelectorAll(".post-card");

  categoryButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const selectedCategory =
        button.getAttribute("data-category");

      categoryButtons.forEach((categoryButton) => {
        categoryButton.classList.remove("active");
        categoryButton.setAttribute("aria-pressed", "false");
      });

      button.classList.add("active");
      button.setAttribute("aria-pressed", "true");

      blogCards.forEach((card) => {
        const cardCategory =
          card.getAttribute("data-category");

        if (
          selectedCategory === "All" ||
          cardCategory === selectedCategory
        ) {
          card.style.display = "";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>
