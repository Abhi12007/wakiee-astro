import pic1 from "../../blog/pictures/1.webp";
import "../../blog/blog.css";

const title = "How Wakiee Was Born — Talk to Strangers";
const description =
  "Learn the story of Wakiee — how a simple idea to connect people across cultures evolved into a platform designed with safety considerations in mind for random video and voice chat and friendship without borders.";

const keywords =
  "Random video chat, learn new cultures, make international friends, talk to strangers online, Stranger Chat, Wakiee, Talk to Strangers";

const canonical =
  "https://wakiee.live/blog/how-wakiee-was-born";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description,
  image: "https://wakiee.live/banner.webp",
  author: {
    "@type": "Organization",
    name: "Wakiee Team"
  },
  publisher: {
    "@type": "Organization",
    name: "Wakiee",
    logo: {
      "@type": "ImageObject",
      url: "https://wakiee.live/wakiee.svg"
    }
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonical
  },
  datePublished: "2026-06-30"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://wakiee.live/"
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: "https://wakiee.live/blog"
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "How Wakiee Was Born — Talk to Strangers",
      item: canonical
    }
  ]
