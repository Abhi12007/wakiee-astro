              <th style="padding:12px;border:1px solid #5a76a3;text-align:left;">Advanced goal</th>
            </tr>
          </thead>

          <tbody>
            <tr>
              <td style="padding:12px;border:1px solid #5a76a3;">Listening</td>
              <td style="padding:12px;border:1px solid #5a76a3;">Understand simple questions</td>
              <td style="padding:12px;border:1px solid #5a76a3;">Follow normal conversation with occasional clarification</td>
