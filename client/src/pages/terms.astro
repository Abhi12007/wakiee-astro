---
import BaseLayout from "../layouts/BaseLayout.astro";

const title =
  "Terms of Service | Wakiee – User Agreement & Community Rules";

const description =
  "Read the Wakiee Terms of Service to understand your rights, responsibilities, community rules, moderation policies, and the conditions for using our platform safely.";

const keywords =
  "wakiee terms, video chat rules, user agreement chat app, wakiee policies, safe chat terms, anonymous video chat rules,terms and conditions";

const robots =
  "index, follow, max-image-preview:large";

const canonical =
  "https://wakiee.live/terms";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: "Terms of Service | Wakiee",
      url: "https://wakiee.live/terms",
      description:
        "Official terms of service outlining rules, policies, and user responsibilities on Wakiee.",
      isPartOf: {
        "@type": "WebSite",
        "@id": "https://wakiee.live/#website"
      },
      publisher: {
        "@type": "Organization",
        name: "Wakiee",
        url: "https://wakiee.live/",
        logo: {
          "@type": "ImageObject",
          url: "https://wakiee.live/android-chrome-192x192.png"
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://wakiee.live/"
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Terms of Service",
          item: "https://wakiee.live/terms"
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  robots={robots}
  canonical={canonical}
  ogTitle="Terms of Service | Wakiee"
  ogDescription="Understand Wakiee rules, policies, and user responsibilities."
  ogImage="https://wakiee.live/android-chrome-192x192.png"
  ogUrl={canonical}
  ogType="website"
  twitterTitle="Wakiee Terms of Service"
  twitterDescription="Read Wakiee terms and policies for safe communication."
  twitterImage="https://wakiee.live/android-chrome-192x192.png"
  schema={schema}
>
  <div
    style={{
      padding: "30px",
      maxWidth: "900px",
      margin: "auto",
      lineHeight: "1.6"
    }}
  >
    <h1
      style={{
        textAlign: "center",
        marginBottom: "20px"
      }}
    >
      Terms of Service for Wakiee
    </h1>

    <p>
      <strong>Last updated:</strong> July 2026
    </p>

    <p>
      Welcome to <strong>Wakiee</strong> (the “Website”, “Site”, “We”, “Us”,
      or “Our”), accessible from{" "}
      <a
        href="https://wakiee.live"
        target="_blank"
        rel="noopener noreferrer"
        style={{ color: "#4FA3FF" }}
      >
        https://wakiee.live
      </a>{" "}
      .
      This Website is owned and operated by{" "}
      <strong>Wakiee Technologies</strong> (“the Owner”), located in India.
    </p>

    <p>
      Use of this Website constitutes your agreement to abide by the most
      current version of these Terms of Service (“Terms”). Please read these
      Terms carefully along with our{" "}
      <a href="/privacy" style={{ color: "#4FA3FF" }}>
        Privacy Policy
      </a>
      , which explains how we handle your personal information.
    </p>

    <p>
      These Terms of Service establish the legal agreement between you and
      Wakiee regarding access to and use of our platform. They are intended to
      promote a safe, respectful, and responsible environment for online
      communication while protecting the rights, privacy, and security of our
      users. By continuing to use Wakiee, you acknowledge that you understand
      these Terms and agree to follow our platform policies, including our{" "}
      <a href="/guidelines" style={{ color: "#4FA3FF" }}>
        Community Guidelines
      </a>
      ,{" "}
      <a href="/privacy" style={{ color: "#4FA3FF" }}>
        Privacy Policy
      </a>
      , and other applicable policies.
    </p>

    <p>
      Wakiee is committed to improving platform safety through AI-assisted
      moderation, human review where appropriate, community reporting, and
      ongoing improvements to our technical infrastructure. Our goal is to
      provide users with a reliable platform for respectful voice, video, and
      text communication while maintaining transparency about our policies and
      responsibilities.
    </p>

    <h2>1. Your Agreement</h2>

    <p>
      By accessing or using <strong>Wakiee</strong>, you confirm that:
    </p>

    <ul>
      <li>You are at least 18 years old.</li>
      <li>You have read, understood, and agree to these Terms.</li>
      <li>
        You will comply with all applicable laws and community standards while
        using the Website.
      </li>
    </ul>

    <p>
      If you disagree with any part of these Terms, please discontinue use of
      the Website immediately.
    </p>

    <h2>2. Services Overview</h2>

    <p>Wakiee provides an online platform designed for users to:</p>

    <ul>
      <li>
        Engage in peer-to-peer voive and video calls with strangers without the
        need for an account or profile.
      </li>
      <li>
        Use camera and microphone features temporarily for live sessions.
      </li>
      <li>
        Participate in text-based chats without the need for an account or
        profile.
      </li>
      <li>
        Read and engage with blogs published on the Wakiee website.
      </li>
    </ul>

    <p>
      Chats are designed to be anonymous, and Wakiee does not store messages or
      video streams. Limited technical data may be processed temporarily to
      operate the service, prevent abuse, and comply with legal obligations, as
      described in our Privacy Policy.
    </p>

    <p>
      The platform includes a <strong>Report</strong> button that allows users
      to flag inappropriate behavior. Moderation is performed using a
      combination of automated tools and human review.
    </p>

    <p>
      Users may leave conversations at any time and use in-app controls to
      report or block other users. In certain chat modes, rooms may be
      moderated, and participants can be removed for violations of community
      rules.
    </p>

    <p>
      Wakiee is intended to encourage respectful conversations, cultural
      exchange, language practice, learning, and social interaction through
      real-time voice, video, and text communication. While users may meet
      people from different countries and backgrounds, every interaction should
      remain respectful, lawful, and consistent with our Community Guidelines
      and Terms of Service.
    </p>

    <p>
      To help maintain a positive experience, Wakiee combines AI-assisted
      moderation, human review where appropriate, community reporting, and
      platform-level enforcement tools. Depending on the severity of a
      violation, moderation actions may include warnings, temporary
      restrictions, removal from conversations or rooms, temporary bans, or
      permanent bans for serious or repeated violations.
    </p>

    <p>
      Certain Group Voice Rooms may also be managed by room creators or
      designated room administrators who can use moderation features such as
      muting disruptive participants, removing (kicking) users, banning a user
      , or locking a room to control participation. These room-level
      moderation tools help maintain productive discussions and operate
      independently from platform-wide moderation actions.
    </p>

    <h2>3. Eligibility</h2>

    <p>
      Wakiee is strictly intended for users 18 years or older. Any person under
      18 is prohibited from using the Website. We reserve the right to deny or
      terminate access to anyone found violating this rule.
    </p>

    <h2>4. No Account Registration & Data Storage</h2>

    <p>
      Wakiee does not require or support user account creation. We do not
      maintain personal profiles, login systems, or chat/call history. All
      communication is temporary and ends once you disconnect. We do not store
      personal data, chat content, or media.
    </p>

    <h2>5. Refund Policy</h2>

    <p>
      Wakiee currently offers its services free of charge. If paid features or
      subscriptions are introduced in the future, our refund process will
      follow these principles:
    </p>

    <ul>
      <li>
        Refunds are only issued in cases of fraudulent or duplicate payments.
      </li>
      <li>
        All refund requests must be submitted to contact@wakiee.live within 7
        days of payment.
      </li>
      <li>
        Approved refunds will be processed to the original payment method
        within 7–10 business days.
      </li>
    </ul>

    <p>
      Wakiee reserves the right to deny refunds for misuse or violations of
      these Terms.
    </p>

    <h2>6. User Conduct and Responsibility</h2>

    <h3>6.1 Acceptable Use</h3>

    <ul>
      <li>
        Communicate respectfully, honestly, and lawfully with other users.
      </li>
      <li>
        Use voice, video, text chat, and Group Voice Rooms responsibly.
      </li>
      <li>
        Respect the privacy, dignity, and personal boundaries of other users.
      </li>
      <li>
        Avoid sharing passwords, financial information, government
        identification documents, or other sensitive personal information.
      </li>
      <li>
        Follow our Community Guidelines, Privacy Policy, and these Terms of
        Service at all times.
      </li>
      <li>
        Report behaviour that may violate our policies using the available
        reporting tools.
      </li>
      <li>
        Help maintain a safe and welcoming community for all users.
      </li>
    </ul>

    <h3>6.2 Prohibited Conduct</h3>

    <ul>
      <li>
        Harassment, bullying, intimidation, threats, or abusive behaviour.
      </li>
      <li>
        Nudity, sexually explicit content, or sexually exploitative behaviour.
      </li>
      <li>
        Hate speech, discrimination, violent or extremist content.
      </li>
      <li>
        Spam, scams, phishing attempts, or fraudulent activity.
      </li>
      <li>
        Impersonating another person, organisation, or public figure.
      </li>
      <li>
        Sharing malware, harmful software, or malicious links.
      </li>
      <li>
        Recording, copying, publishing, or distributing conversations without
        appropriate permission.
      </li>
      <li>
        Sharing another person's private or confidential information without
        consent.
      </li>
      <li>
        Commercial advertising, unsolicited promotions, or repeated unwanted
        messages.
      </li>
      <li>
        Attempting to bypass moderation systems or interfere with the
        operation, security, or reliability of the platform.
      </li>
      <li>
        Targeting minors or engaging in illegal, predatory, or exploitative
        behaviour.
      </li>
      <li>
        Any activity that violates applicable laws or these Terms of Service.
      </li>
    </ul>

    <h3>6.3 Reporting</h3>

    <p>
      Users are encouraged to report behaviour that may violate these Terms or
      our Community Guidelines using the Report feature available within the
      platform. Reports may be reviewed through AI-assisted systems together
      with human moderation where appropriate. Depending on the nature and
      severity of the violation, enforcement actions may include warnings,
      temporary restrictions, removal from conversations or rooms, temporary
      bans, or permanent bans. Repeated or serious violations may also result
      in suspension of access to Wakiee without prior notice.
    </p>

    <h2>7. Content Moderation & Safety Policy</h2>

    <p>
      Wakiee is committed to providing a respectful, safe, and privacy-conscious
      communication platform. To support this goal, we use a combination of
      AI-assisted moderation, human review where appropriate, community
      reporting, and platform enforcement tools to help identify behaviour that
      may violate our Community Guidelines or these Terms of Service.
    </p>

    <p>
      Users are encouraged to report inappropriate behaviour using the
      reporting tools available within the platform. Reports help our
      moderation systems identify potential policy violations and may be
      reviewed through AI-assisted technology together with human moderation
      where appropriate. Depending on the nature and severity of the violation,
      moderation actions may include warnings, temporary restrictions, removal
      from conversations or rooms, temporary bans, or permanent bans.
    </p>

    <p>
      Behaviour that may result in moderation action includes, but is not
      limited to, harassment, bullying, hate speech, threats, nudity, sexually
      explicit content, spam, scams, impersonation, illegal activity, repeated
      disruptive behaviour, or attempts to bypass platform security or
      moderation systems.
    </p>

    <p>
      Some Group Voice Rooms may also be managed by room creators or designated
      room administrators. Depending on their permissions, room moderators may
      mute participants, remove (kick) disruptive users, or lock rooms to help
      maintain respectful and productive discussions. Room-level moderation
      operates independently from platform-wide enforcement actions.
    </p>

    <p>
      We continuously review our moderation processes, safety practices,
      technical infrastructure, and community feedback to improve user safety,
      reduce abuse, and support a welcoming environment for everyone.
      Additional information is available in our{" "}
      <a href="/guidelines" style={{ color: "#4FA3FF" }}>
        Community Guidelines
      </a>
      ,{" "}
      <a href="/privacy" style={{ color: "#4FA3FF" }}>
        Privacy Policy
      </a>
      , and{" "}
      <a href="/faq" style={{ color: "#4FA3FF" }}>
        FAQ
      </a>
      .
    </p>

    <h2>8. Limitation of Liability</h2>

    <p>
      Wakiee provides its services on an “as-is” basis. We make no warranties,
      express or implied, regarding continuous availability, safety, or
      user-generated content.
    </p>

    <p>
      By using Wakiee, you acknowledge that you interact at your own risk. We
      are not liable for damages, loss, or injury arising from user
      interactions or technical interruptions.
    </p>

    <h2>9. Termination</h2>

    <p>
      We may terminate or suspend access without notice if you violate these
      Terms or applicable laws, or if repeated reports of misconduct occur.
      Upon termination, access ceases immediately.
    </p>

    <h2>10. Platform Enforcement & Appeals</h2>

    <p>
      To help maintain a safe and respectful environment, Wakiee may take
      enforcement action when users violate these Terms of Service, our
      Community Guidelines, or applicable laws. Enforcement decisions are
      intended to protect the platform, its users, and the integrity of our
      services.
    </p>

    <p>
      Depending on the nature, severity, and frequency of a violation,
      enforcement actions may include warnings, temporary restrictions, removal
      from conversations or Group Voice Rooms, temporary bans, permanent bans,
      or other appropriate measures. Serious or repeated violations may result
      in immediate loss of access to the platform.
    </p>

    <p>
      If you believe moderation or enforcement action has been applied
      incorrectly, you may contact Wakiee through our{" "}
      <a href="/contact" style={{ color: "#4FA3FF" }}>
        Contact Page
      </a>{" "}
      for additional assistance. While we review genuine enquiries where
      appropriate, submission of an appeal does not guarantee that a moderation
      decision will be changed.
    </p>

    <h2>11. Changes to Terms</h2>

    <p>
      Wakiee may update or modify these Terms at any time. Updates will be
      posted with a revised “Last Updated” date. Continued use means acceptance
      of revised Terms.
    </p>

    <h2>12. Governing Law</h2>

    <p>
      These Terms are governed by the laws of India. All disputes are subject
      to the exclusive jurisdiction of the courts in Delhi, India.
    </p>

    <h2>13. Contact</h2>

    <p>
      If you have questions about these Terms of Service, wish to report a
      legal issue, submit a copyright enquiry, appeal a moderation decision
      where applicable, or require general assistance regarding the use of
      Wakiee, please contact us using the details below.
    </p>

    <p>
      <strong>Email:</strong> contact@wakiee.live
      <br />
      <strong>Organisation:</strong> Wakiee Technologies
      <br />
      <strong>Location:</strong> Delhi, India
    </p>

    <h2>14. Third-Party Content Disclaimer</h2>

    <p>
      Wakiee may display third-party advertisements or content for information
      purposes. We do not control, endorse, or assume responsibility for any
      third-party websites or services.
    </p>

    <h2>15. Intellectual Property</h2>

    <p>
      All trademarks, logos, and materials on Wakiee belong to Wakiee
      Technologies or its licensors. Unauthorized copying, reproduction, or
      redistribution is prohibited.
    </p>

    <h2>16. Indemnification</h2>

    <p>
      You agree to indemnify and hold harmless Wakiee Technologies, its owners,
      employees, and partners from claims, damages, or liabilities resulting
      from your actions or violations of these Terms.
    </p>

    <h2>17. Google AdSense & Cookies</h2>

    <p>
      Wakiee displays ads served by <strong>Google AdSense</strong> and other
      third-party partners. These vendors may use cookies to collect
      non-personal browsing data to deliver personalized advertisements. By
      using Wakiee, you consent to the use of such cookies as described in our{" "}
      <a href="/privacy" style={{ color: "#4FA3FF" }}>
        Privacy Policy
      </a>
      .
    </p>

    <p>
      Users may opt out of personalized ads by visiting{" "}
      <a
        href="https://adssettings.google.com"
        target="_blank"
        rel="noopener noreferrer"
        style={{ color: "#4FA3FF" }}
      >
        Google Ads Settings
      </a>
      .
    </p>

    <h2>18. Cookies and Analytics</h2>

    <p>
      Wakiee uses cookies and analytics tools to enhance user experience and
      deliver relevant advertisements. By using Wakiee, you consent to cookies
      as described in our{" "}
      <a href="/privacy" style={{ color: "#4FA3FF" }}>
        Privacy Policy
      </a>
      .
    </p>

    <p>
      Cookies and analytics technologies help us understand website performance,
      identify technical issues, improve reliability, and enhance the overall
      user experience. Users can manage cookie preferences through their
      browser settings, although disabling certain cookies may affect some
      website functionality.
    </p>

    <h2>19. Service Availability (Force Majeure)</h2>

    <p>
      Wakiee does not guarantee uninterrupted service. Temporary outages may
      occur due to maintenance, network issues, or factors beyond our control.
      We are not responsible for any data loss or interruption caused by such
      events.
    </p>

    <p>
      We may also temporarily suspend services for security improvements,
      maintenance, technical upgrades, or emergency situations intended to
      protect the stability, security, and reliability of the platform.
    </p>

    <p
      style={{
        marginTop: "40px",
        textAlign: "center",
        opacity: 0.8
      }}
    >
      Learn more about our{" "}
      <a href="/privacy" style={{ color: "#4FA3FF" }}>
        Privacy Policy
      </a>
      ,{" "}
      <a href="/guidelines" style={{ color: "#4FA3FF" }}>
        Community Guidelines
      </a>
      , and{" "}
      <a href="/contact" style={{ color: "#4FA3FF" }}>
        Contact Page
      </a>
      .
    </p>
  </div>
</BaseLayout>
