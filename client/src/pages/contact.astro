---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Contact Wakiee – Support, Feedback & Help";

const description =
  "Contact Wakiee for support, feedback, or partnerships. Reach us via email at contact@wakiee.live or connect on social media. We'd love to hear from you!";

const keywords =
  "contact wakiee, wakiee support, video chat help, voice chat support, contact chat platform, online chat support,wakiee help,email,wakiee contact,customer support";

const canonical = "https://wakiee.live/contact";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "name": "Contact Wakiee",
      "url": "https://wakiee.live/contact",
      "description":
        "Contact Wakiee for support, feedback, and platform-related queries.",

      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://wakiee.live/#website"
      },

      "publisher": {
        "@type": "Organization",
        "name": "Wakiee",
        "url": "https://wakiee.live/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://wakiee.live/android-chrome-192x192.png"
        }
      },

      "contactPoint": {
        "@type": "ContactPoint",
        "email": "contact@wakiee.live",
        "contactType": "Customer Support",
        "areaServed": "Worldwide",
        "availableLanguage": "English"
      }
    },

    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://wakiee.live/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Contact",
          "item": "https://wakiee.live/contact"
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  robots="index, follow, max-image-preview:large"
  canonical={canonical}
  ogTitle="Contact Wakiee"
  ogDescription="Reach out to Wakiee for support, feedback, and help."
  ogImage="https://wakiee.live/android-chrome-192x192.png"
  ogUrl={canonical}
  ogType="website"
  twitterTitle="Contact Wakiee"
  twitterDescription="Contact Wakiee support team for assistance."
  twitterImage="https://wakiee.live/android-chrome-192x192.png"
  schema={schema}
>
  <div
    style="
      padding: 40px 20px;
      max-width: 1000px;
      margin: auto;
      line-height: 1.6;
      font-family: Poppins, sans-serif;
      color: white;
    "
  >
    <!-- Grey thin border container -->
    <div
      style="
        border: 1px solid #444;
        border-radius: 16px;
        padding: 30px 25px;
        background-color: transparent;
      "
    >
      <!-- PAGE HEADING -->
      <h1 style="text-align: center; margin-bottom: 16px;">
        Contact Wakiee
      </h1>

      <!-- INTRO TEXT -->
      <p style="text-align: center; margin-bottom: 40px;">
        Have a question, feedback, or collaboration idea? We'd love to hear from
        you! Our team is here to help ensure that your experience on Wakiee is
        smooth, safe, and enjoyable. Most genuine enquiries receive a response within 1–2 business days, although response times may vary depending on request volume.
      </p>

      <!-- MAIN CONTACT BOXES - RESPONSIVE GRID -->
      <div
        style="
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
          gap: 30px;
        "
      >
        <!-- EMAIL BOX -->
        <div class="contact-box">
          <h2 style="margin-bottom: 20px;">Customer Support</h2>

          <a
            href="mailto:contact@wakiee.live"
            class="support-email"
          >
            contact@wakiee.live
          </a>
        </div>

        <!-- SOCIAL MEDIA BOX -->
        <div class="contact-box">
          <h2 style="margin-bottom: 30px;">Follow Wakiee</h2>

          <div
            style="
              display: flex;
              justify-content: center;
              gap: 30px;
              margin-top: 18px;
              flex-wrap: wrap;
            "
          >
            <!-- Instagram SVG -->
            <a
              href="https://www.instagram.com/wakiee.live"
              target="_blank"
              rel="noreferrer"
              class="social-icon-link"
              aria-label="Wakiee on Instagram"
            >
              <svg
                class="social-icon"
                viewBox="0 0 24 24"
                fill="white"
              >
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/>
              </svg>
            </a>

            <!-- Twitter X SVG -->
            <a
              href="https://x.com/wakiee_live"
              target="_blank"
              rel="noreferrer"
              class="social-icon-link"
              aria-label="Wakiee on X"
            >
              <svg
                class="social-icon"
                viewBox="0 0 24 24"
                fill="white"
              >
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>

            <!-- YouTube SVG -->
            <a
              href="https://www.youtube.com/@wakieelive"
              target="_blank"
              rel="noreferrer"
              class="social-icon-link"
              aria-label="Wakiee on YouTube"
            >
              <svg
                class="social-icon"
                viewBox="0 0 24 24"
                fill="white"
              >
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- FOOTER TRUST TEXT -->
      <p
        style="
          text-align: center;
          margin-top: 20px;
          opacity: 0.8;
        "
      >
        Wakiee respects your privacy and limits the use of contact details to
        support and communication purposes. Contacting Wakiee by email or through our official social media accounts is subject to our {" "}
        <a href="/privacy" style="color: #00c3ff;">
          Privacy Policy
        </a>{" "}
        and{" "}
        <a href="/terms" style="color: #00c3ff;">
          Terms of Service
        </a>
        .
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  /* =====================
     SHARED BOX STYLE (Wakiee theme + hover)
  ====================== */

  .contact-box {
    background: linear-gradient(145deg, #1f245c, #2b2f77);
    border-radius: 20px;
    padding: 42px 34px;
    text-align: center;
    transition: all 0.3s ease;
    transform: translateY(0);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.3);
  }

  .contact-box:hover {
    transform: translateY(-6px);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.45),
      inset 0 0 30px rgba(255, 255, 255, 0.2);
  }

  .support-email {
    color: #6ea8ff;
    text-decoration: none;
    font-size: 20px;
    font-weight: 500;
    transition: all 0.3s ease;
    display: inline-block;
    padding: 10px 20px;
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .support-email:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
  }

  .social-icon-link {
    display: inline-block;
  }

  .social-icon {
    width: 48px;
    height: 48px;
    transition: all 0.3s ease;
    transform: scale(1);
    filter: none;
    cursor: pointer;
  }

  .social-icon-link:hover .social-icon {
    transform: scale(1.2);
    filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.8));
  }
</style>


